{
  "name": "xnat-docs",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "npm run dev:xnat",
    "dev:xnat": "cd sites/xnat && astro dev --port 4321 --host",
    "start": "npm run dev",
    "build": "npm run build:xnat",
    "build:xnat": "cd sites/xnat && astro build",
    "check": "npm run check:xnat",
    "check:xnat": "cd sites/xnat && astro check",
    "check:links": "npm run check:links:xnat",
    "check:links:xnat": "node .github/scripts/check-links.mjs sites/xnat/dist",
    "preview": "cd sites/xnat && astro preview",
    "astro": "cd sites/xnat && astro"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.5",
    "astro": "^7.3.5",
    "sharp": "^0.35.4"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3"
  }
}
